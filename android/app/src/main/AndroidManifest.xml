<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Nur fuer die Bild-Links aus dem Web. Kein CAMERA: die Aufnahme laeuft ueber
         den Intent der Kamera-App, und waere die Berechtigung deklariert, wuerde
         Android sie dafuer plötzlich verlangen. Kein Speicherzugriff: der MediaStore
         braucht ab API 29 keinen. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Ohne das liefert resolveActivity() ab Android 11 null, obwohl eine
         Kamera-App da ist: Pakete sind seither standardmaessig unsichtbar. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TokenSheet">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Empfaenger fuer Bilder: aus Galerie, Browser oder sonstwo auf
                 "Teilen" tippen und die App waehlen. Das Bild landet im naechsten
                 freien Platz. Bewusst nur image/*, damit die App nicht in jedem
                 Text-Teilen-Dialog auftaucht. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Gibt genau die beiden Cache-Ordner frei, aus denen geteilt bzw. in die
             fotografiert wird. Nicht mehr. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
